{
  "name": "ssh-master",
  "productName": "SSH Master",
  "version": "1.1.0",
  "description": "SSH bağlantı yöneticisi, terminal ve SFTP dosya yöneticisi",
  "main": "src/main.js",
  "author": "SSH Master",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "com.sshmaster.app",
    "productName": "SSH Master",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "SSH-Master-Setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SSH Master",
      "include": "build/installer.nsh",
      "menuCategory": "Master Tool"
    },
    "portable": {
      "artifactName": "SSH-Master-Portable-${version}.exe"
    }
  }
}
